{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harness",
  "version": "0.1.0",
  "identifier": "com.harness.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Harness", "width": 1360, "height": 860, "minWidth": 900, "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPmeUI" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
